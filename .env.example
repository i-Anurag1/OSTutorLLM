# Copy to .env (RUN.bat does this for you). Everything has a working default.
POSTGRES_DB=ostutor
POSTGRES_USER=ostutor
POSTGRES_PASSWORD=ostutor
JWT_SECRET=ostutor-local-development-secret-change-in-production

# --- Language model (Ollama on the host by default, no API key needed) ---
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
# Require Ollama/OpenAI-compatible generation for tutor answers; set 0 only for intentional extractive-only mode.
LLM_REQUIRED=1
# Stock model. After fine-tuning (see training/README.md) set this to ostutor-qwen3.
LLM_MODEL=qwen3:14b
LLM_NUM_PREDICT=900
LLM_TIMEOUT=300

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_DENSE_K=24
RAG_SPARSE_K=24
RAG_RERANK_K=12
# The tutor declines when less than this share of the question's key terms is covered by the evidence (0-1).
RAG_MIN_COVERAGE=0.4

CACHE_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000
MAX_CODE_SECONDS=3
NEXT_PUBLIC_API_URL=http://localhost:8000
