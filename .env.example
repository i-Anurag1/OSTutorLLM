POSTGRES_DB=ostutor
POSTGRES_USER=ostutor
POSTGRES_PASSWORD=ostutor
DATABASE_URL=postgresql+psycopg://ostutor:ostutor@db:5432/ostutor
REDIS_URL=redis://redis:6379/0
JWT_SECRET=ostutor-local-development-secret-change-in-production
# Local Option 1: Ollama on the host. No API key is required.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:14b
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_DENSE_K=24
RAG_SPARSE_K=24
RAG_RERANK_K=12
CACHE_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000
MAX_CODE_SECONDS=3
NEXT_PUBLIC_API_URL=http://localhost:8000
